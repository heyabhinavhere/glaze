{
  "name": "glaze-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Glazelab monorepo — @glazelab/core, framework wrappers, and the playground.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "corepack pnpm --filter playground dev",
    "build": "corepack pnpm -r build",
    "build:core": "corepack pnpm --filter @glazelab/core build",
    "build:playground": "corepack pnpm --filter playground build",
    "lint": "corepack pnpm -r lint",
    "size": "corepack pnpm --filter @glazelab/core size",
    "typecheck": "corepack pnpm -r typecheck",
    "test:unit": "vitest run tests/displacement.test.ts tests/m2-explicit-video.test.ts",
    "test:m1": "playwright test tests/m1.spec.ts",
    "test:m1:visual": "playwright test tests/m1.spec.ts --grep @visual",
    "test:m1:performance": "playwright test tests/m1.spec.ts --grep @performance",
    "test:m1.1:stage-a": "playwright test -c playwright.m1-1.config.ts tests/m1.spec.ts --grep-invert @visual",
    "evidence:m1.1:stage-a": "vitest run tests/m1-1-artifacts.test.ts",
    "test:m2:video": "playwright test -c playwright.m2-video.config.ts tests/m2-explicit-video.spec.ts",
    "evidence:m2:video": "vitest run tests/m2-explicit-video-artifacts.test.ts",
    "evidence:m1": "vitest run tests/m1-artifacts.test.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
